# Nightly Postgres + MinIO backup for the production stack (see
# scripts/README.md). Installed to /etc/systemd/system/ on the VPS; triggered
# by nasiha-backup.timer. Logs: journalctl -u nasiha-backup
[Unit]
Description=Nasiha Postgres + MinIO backup
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
SupplementaryGroups=docker
Environment=HOME=/home/ubuntu
# Each run is a full copy (~2.6G as of 2026-11); 7 days keeps ~8 backups.
Environment=RETENTION_DAYS=7
ExecStart=/home/ubuntu/nasiha/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
