# Used by vps/docker-compose.yml to pass secrets into the app/worker
# containers on the production VPS. Copy to vps/.env and fill in real
# values, then `docker compose up -d` from inside vps/.
#
# This is the production counterpart of homelab/.env.example — same
# variable names, but several values differ in meaning here because this
# host runs its own self-hosted LiveKit/MinIO instead of pointing at
# homelab's or a cloud service. Differences are called out below.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
CLERK_SECRET_KEY="sk_live_..."
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."
NEXT_PUBLIC_APP_URL="https://nasihaforyou.org"

# This VPS is the production deployment — leave unset/false so real
# member-facing emails actually send. See lib/email.ts.
IS_TEST_ENVIRONMENT="false"

# Resend (https://resend.com) — sends the /join application confirmation email.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="NASIHA <no-reply@mail.nasihaforyou.org>"

# Stripe (https://dashboard.stripe.com/apikeys) — /donate checkout (§4.14).
# STRIPE_WEBHOOK_SIGNING_SECRET comes from the webhook endpoint registered
# at https://nasihaforyou.org/api/webhooks/stripe.
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SIGNING_SECRET="whsec_..."

# Google Calendar (§4.7 meeting requests) — see homelab/.env.example for the
# full setup rationale (dedicated Gmail account, OAuth "Desktop app" client,
# `npm run get:google-refresh-token`). Same account/credentials as homelab.
GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="..."
GOOGLE_CALENDAR_REFRESH_TOKEN="..."
GOOGLE_CALENDAR_ID="primary"

# Self-hosted LiveKit (see the livekit/egress services in this same
# docker-compose.yml, and livekit.yaml.example/egress.yaml.example) — NOT
# LiveKit Cloud, unlike homelab/.env.example's example value. LIVEKIT_URL is
# the nginx-proxy-manager-fronted hostname for the livekit service.
# LIVEKIT_API_KEY/LIVEKIT_API_SECRET here MUST be the exact same pair
# generated into vps/livekit.yaml's `keys:` section and vps/egress.yaml's
# api_key/api_secret — these three files share one secret, not three.
LIVEKIT_URL="wss://livekit.nasihaforyou.org"
LIVEKIT_API_KEY="..."
LIVEKIT_API_SECRET="..."

# MinIO recordings bucket — see homelab/.env.example for the full
# rationale (why this is a separate credential/endpoint from the admin
# MINIO_ROOT_USER/PASSWORD baked into this docker-compose.yml's minio
# service). MINIO_PUBLIC_ENDPOINT is the nginx-proxy-manager-fronted
# hostname aliased in this compose file's nginxproxymanager service
# ("vps-s3.nasihaforyou.org"). Run scripts/setup-minio-recordings.sh once
# against this host to create the access key and bucket.
MINIO_BUCKET_RECORDINGS="livekit-recordings"
MINIO_RECORDINGS_ACCESS_KEY="..."
MINIO_RECORDINGS_SECRET_KEY="..."
MINIO_PUBLIC_ENDPOINT="vps-s3.nasihaforyou.org"
MINIO_PUBLIC_PORT="443"
MINIO_PUBLIC_USE_SSL="true"

# NOT covered by this file: GF_SECURITY_ADMIN_PASSWORD for the grafana
# service is a literal placeholder hardcoded directly in
# vps/docker-compose.yml (not read from .env) — replace
# "<GENERATE_ADMIN_PASSWORD>" there by hand after first deploy.
