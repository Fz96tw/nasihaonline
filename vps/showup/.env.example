# Copy to /home/ubuntu/showup/.env on the VPS (VPS-only, never committed).
# Same LiveKit key/secret the Nasiha stack uses (they live in its .env / livekit.yaml).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional overrides (defaults are in docker-compose.yml)
# LIVEKIT_URL=wss://livekit.nasihaforyou.org
# NEXT_PUBLIC_APP_URL=https://showup.cloudcurio.com

# Showup's own MinIO bucket + scoped user (created by scripts/setup-minio-showup-recordings.sh)
MINIO_RECORDINGS_BUCKET=showup-recordings
MINIO_RECORDINGS_ACCESS_KEY=showup-recorder
MINIO_RECORDINGS_SECRET_KEY=

# Downloads are presigned for the address a browser can reach (defaults shown)
# MINIO_PUBLIC_ENDPOINT=vps-s3.nasihaforyou.org
# MINIO_PUBLIC_PORT=443
# MINIO_PUBLIC_USE_SSL=true

# Optional "Email me the link" (Resend, sender domain mail.nasihaforyou.org). Unset = feature hidden.
RESEND_API_KEY=
# RESEND_FROM_EMAIL=Showup <no-reply@mail.nasihaforyou.org>
