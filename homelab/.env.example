# Used by docker-compose.yml to pass Clerk keys into the app container.
# Copy to .env (repo root) and fill in real values from https://dashboard.clerk.com.
# For local dev without Docker, web/.env.example has the same variables.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."
NEXT_PUBLIC_APP_URL="http://localhost:3010"

# Set "true" on a non-production deployment to keep sendEmail() (lib/email.ts)
# from mailing real members — it silently drops any send whose recipients
# aren't all admins. Leave unset/false on the actual production host.
IS_TEST_ENVIRONMENT="false"

# Resend (https://resend.com) — sends the /join application confirmation email.
# Left unset in dev: lib/email.ts logs and skips sending rather than failing.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Nasiha <no-reply@nasihaonline.org>"

# Stripe (https://dashboard.stripe.com/test/apikeys) — /donate checkout (§4.14).
# STRIPE_WEBHOOK_SIGNING_SECRET comes from the webhook endpoint you register
# pointing at <your-app-url>/api/webhooks/stripe (or `stripe listen` locally).
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SIGNING_SECRET="whsec_..."

# Google Calendar (§4.7 meeting requests) — auto-generates a Google Meet
# link when a meeting request is accepted. There's no Google Workspace
# domain here, so this is a single dedicated Gmail account authorized once
# via OAuth (not a service-account key, which can't create Meet links
# without Workspace domain-wide delegation). GOOGLE_CLIENT_ID/SECRET come
# from a "Desktop app" OAuth client in Google Cloud Console (Calendar API
# enabled); GOOGLE_CALENDAR_REFRESH_TOKEN comes from running
# `npm run get:google-refresh-token` once, signed in as that account. Left
# unset in dev: lib/google-calendar.ts logs and skips Meet-link creation
# rather than failing meeting-request acceptance.
GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="..."
GOOGLE_CALENDAR_REFRESH_TOKEN="..."
GOOGLE_CALENDAR_ID="primary"

# LiveKit (https://cloud.livekit.io) — the "LiveKit" option offered
# alongside Google Meet when creating an Event or 1:1 meeting request
# (lib/livekit.ts). Left unset in dev: room creation is skipped and the
# LiveKit option's meeting stays without a room, same non-fatal philosophy
# as an unconfigured GOOGLE_CALENDAR_REFRESH_TOKEN above.
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="..."
LIVEKIT_API_SECRET="..."

# LiveKit egress writes meeting recordings into the local MinIO container's
# "livekit-recordings" bucket first (see docker-compose.yml's minio service —
# MINIO_ACCESS_KEY/MINIO_SECRET_KEY there are the admin creds, not these).
# lib/recordings-storage.ts then needs its own presigned-URL client to hand
# recordings to members in the browser, which is why it talks to MinIO over
# a *second*, publicly-reachable set of credentials/endpoint instead of the
# admin ones or the internal "minio:9000" hostname. Run
# scripts/setup-minio-recordings.sh once to create that access key and the
# bucket. Left unset in dev: recordings sync becomes a no-op, same
# non-fatal philosophy as an unconfigured LIVEKIT_URL above.
MINIO_BUCKET_RECORDINGS="livekit-recordings"
MINIO_RECORDINGS_ACCESS_KEY="..."
MINIO_RECORDINGS_SECRET_KEY="..."
MINIO_PUBLIC_ENDPOINT="minio.your-domain.org"
MINIO_PUBLIC_PORT="443"
MINIO_PUBLIC_USE_SSL="true"
