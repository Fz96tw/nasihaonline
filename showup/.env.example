# Copy to .env.local for local dev. Never commit real values.

# Shared self-hosted LiveKit (the same instance Nasiha uses). Rooms are namespaced
# by the "showup-" prefix in lib/room-code.ts, so test rooms don't collide.
LIVEKIT_URL=wss://livekit.nasihaforyou.org
# Copy the key/secret from web/.env (or the VPS .env); they aren't committed.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Room-code claims and rate limits. Start/join answer 503 without it. Local dev: docker run -d --name showup-redis -p 6380:6379 redis:7-alpine
REDIS_URL=redis://localhost:6380

# Optional. Base URL of the MinIO S3 endpoint (e.g. https://s3.nasihaforyou.org). Only
# recording/downloads use it; /api/health reports it as "down" or "not_configured"
# without affecting meetings.
MINIO_ENDPOINT=
