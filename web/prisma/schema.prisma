// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  guest
  applicant
  member
  moderator
  admin
}

// Member-facing classification, distinct from the system Role — PRD §2.2/§7.1
// calls this out as a required first-class field on User, separate from role.
enum Tier {
  active
  associate
  student
  friend
}

model User {
  id                        String     @id @default(cuid())
  clerkUserId               String     @unique
  email                     String     @unique
  name                      String?
  role                      Role       @default(applicant)
  tier                      Tier?
  // Trust & Safety state (§4.15) — deliberately separate from role/tier: a
  // suspended member is blocked from login/member routes (enforced in app
  // code, not here) but their historical ledger/content rows are untouched.
  suspended                 Boolean    @default(false)
  suspendedAt               DateTime?
  // First-sign-in (not registration) welcome shout-out fire-once guard —
  // set atomically in getSessionUser() so concurrent requests can't double-post.
  welcomeAnnouncementSentAt DateTime?
  // True only for accounts created after the /join field-reduction (§3.1,
  // set explicitly in the `create` branch of upsertUserFromClerkData) —
  // subjects them to the (member) layout's hard onboarding gate
  // (getMissingRequiredProfileFields, lib/profile-server.ts) until their
  // Profile has the fields /join no longer collects. Defaults false so
  // every pre-existing member is grandfathered in: Profile rows have
  // historically been created empty regardless of what a member answered
  // on their original application, so gating on completeness retroactively
  // would lock real, already-approved members out of the app.
  requiresProfileOnboarding Boolean    @default(false)
  profile                   Profile?
  // Denormalized donation attribution only (§4.14) — never joined against
  // for Knowledge Hours/tier logic. See Donation model for the guarantee.
  donations                 Donation[]

  // Knowledge Hours ledger (§4.4) — every relation named since a single
  // user can be the balance-holder, the actor/counterpart on the
  // originating ContributionEvent, or an admin who created/resolved a
  // ledger row, all independently of each other.
  contributionLedgerEntries       ContributionLedger[] @relation("LedgerUser")
  contributionAdjustmentsCreated  ContributionLedger[] @relation("LedgerCreatedBy")
  contributionResolutions         ContributionLedger[] @relation("LedgerResolvedBy")
  contributionEventsAsActor       ContributionEvent[]  @relation("ContributionEventActor")
  contributionEventsAsCounterpart ContributionEvent[]  @relation("ContributionEventCounterpart")

  // Inbox (§4.7) — directory-originated, two-party only, no live chat.
  sentInboxMessages       InboxMessage[]          @relation("InboxMessageSender")
  receivedInboxMessages   InboxMessage[]          @relation("InboxMessageRecipient")
  sentMeetingRequests     MeetingRequest[]        @relation("MeetingRequestSender")
  receivedMeetingRequests MeetingRequest[]        @relation("MeetingRequestRecipient")
  meetingRequestMessages  MeetingRequestMessage[] @relation("MeetingRequestMessageSender")

  notifications Notification[]

  // Events (§4.6) — hostId is required and un-cascaded on delete, same
  // convention as ContributionEvent.actorId, since a host's past events
  // are historical record even if their account is later removed.
  hostedEvents     Event[]        @relation("EventHost")
  eventRsvps       RSVP[]         @relation("EventRsvp")
  eventAttendances Attendance[]   @relation("EventAttendance")
  eventInvitations EventInvitee[] @relation("EventInvitee")
  // Recording Access initiative — members the host has designated as
  // co-host, able to start/stop recording and manage further co-hosts.
  eventCoHostOf    EventCoHost[]  @relation("EventCoHost")
  // Resend Notifications (event detail page) — who triggered each member-wide
  // broadcast, not just the automatic one at createEvent() time.
  eventNotificationBroadcastsSent EventNotificationBroadcast[] @relation("EventNotificationBroadcastSentBy")

  // Knowledge Library / Forums (§4.9/§4.13) — Blog was consolidated into
  // the Library as the blog_post content type; the old Post/PostComment
  // model tree and this relation are retired.
  knowledgeItemsContributed KnowledgeItem[]        @relation("KnowledgeContributor")
  knowledgeItemInvitations  KnowledgeItemInvitee[] @relation("KnowledgeItemInvitee")
  forumThreads              ForumThread[]          @relation("ForumThreadAuthor")
  forumThreadInvitations    ForumThreadInvitee[]   @relation("ForumThreadInvitee")
  forumPosts                ForumPost[]            @relation("ForumPostAuthor")
  forumFollows              ForumFollow[]
  threadViews               ThreadView[]
  eventViews                EventView[]
  knowledgeItemViews        KnowledgeItemView[]

  // Peer Review & Feedback (§4.13 replacement) — invite-only item review,
  // separate from Knowledge Library/Forums (see ReviewItem).
  reviewItemsSubmitted  ReviewItem[]           @relation("ReviewItemSubmitter")
  reviewItemInvitations ReviewItemInvitee[]    @relation("ReviewItemInvitee")
  reviewComments        ReviewComment[]        @relation("ReviewCommentAuthor")
  reviewItemViews       ReviewItemView[]       @relation("ReviewItemViewer")
  reviewVolunteerOffers ReviewVolunteerOffer[] @relation("ReviewVolunteer")

  // Trust & Safety / Compliance / Notifications (§4.10/§4.15) — a member can
  // appear on either side of a conduct report (reported or reporting) and
  // only admins handle reports/requests, so each role gets its own named
  // relation, same multi-role convention as ContributionLedger's User
  // relations above.
  conductViolationsReported  CodeOfConductViolation[] @relation("ConductViolationReported")
  conductViolationsFiled     CodeOfConductViolation[] @relation("ConductViolationReporter")
  conductViolationsHandled   CodeOfConductViolation[] @relation("ConductViolationHandledBy")
  privacyDataRequests        PrivacyDataRequest[]     @relation("PrivacyRequestUser")
  privacyDataRequestsHandled PrivacyDataRequest[]     @relation("PrivacyRequestHandledBy")
  adminActionLogs            AdminActionLog[]         @relation("AdminActionLogActor")
  notificationPreferences    NotificationPreference[]
  announcementsAuthored      Announcement[]           @relation("AnnouncementAuthor")
  announcementsRetracted     Announcement[]           @relation("AnnouncementRetractedBy")
  surveysAuthored            Survey[]                 @relation("SurveyAuthor")
  surveysClosed              Survey[]                 @relation("SurveyClosedBy")
  surveyInvitations          SurveyInvitation[]

  // Tier-promotion audit trail (§7.3) — a user accrues entries as the
  // subject of a change and, separately, as the admin who made one.
  tierHistoryEntries TierHistory[] @relation("TierHistorySubject")
  tierChangesMade    TierHistory[] @relation("TierHistoryActor")

  // Paste-image uploads for Forum posts, Inbox messages, and Library blog
  // bodies — see PastedImage.
  pastedImagesUploaded PastedImage[] @relation("PastedImageUploader")

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  // Last authenticated request, stamped (throttled) in getSessionUser() —
  // the only per-request activity signal in the schema; see lib/auth.ts.
  lastActiveAt DateTime?

  @@map("users")
}

// Append-only audit trail for admin-driven tier changes (§7.3, §11) —
// written whenever an admin edit actually changes User.tier, independent
// of the once-only tier assignment made at application approval.
model TierHistory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("TierHistorySubject", fields: [userId], references: [id])

  fromTier Tier?
  toTier   Tier?

  changedByUserId String
  changedByUser   User   @relation("TierHistoryActor", fields: [changedByUserId], references: [id])

  reason String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("tier_history")
}

// Minimal seed row created alongside every new User (lib/clerk-sync.ts) so
// the full Profile domain (PRD §4.3 — avatar upload, directory prefs, skills)
// has a real record to extend rather than needing a backfill later.
model Profile {
  id                    String                    @id @default(cuid())
  userId                String                    @unique
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                   String?
  // MinIO object key (not a servable URL — see getProfileAvatarUrl in lib/storage.ts),
  // same convention as TeamMember.photoUrl.
  avatarUrl             String?
  countryRegion         String?
  titleSpecialty        String?
  careerStage           String?
  // Public profile link (e.g. LinkedIn) — shown on the full profile page,
  // not the Directory card. Free-form URL, not restricted to linkedin.com.
  linkedinUrl           String?
  // Free-text fallback only, for expertise entries that don't map to a
  // seeded Skill tag (PRD §4.3/§7.3) — tagged expertise lives in
  // ProfileSkill. Not the source of truth for Directory tag filtering.
  expertiseAreas        String[]                  @default([])
  learningTopics        String?
  interestAreas         InterestArea[]            @default([])
  // How the member can participate (§3.1) — collected at application time
  // only until now; also editable here since availability changes over time.
  availability          ApplicationAvailability[] @default([])
  skills                ProfileSkill[]
  // Directory visibility prefs (§4.3/§4.5/§9) — enforced server-side in
  // lib/members-server.ts, not just hidden client-side.
  listInDirectory       Boolean                   @default(true)
  showSpecialtyLocation Boolean                   @default(true)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@map("profiles")
}

// Normalized expertise tag (PRD §4.3/§7.3 — migrates "areas of expertise"
// from pure free text toward a taggable model to power Directory
// search/filter). Seeded from a fixed list (prisma/seed.ts); members can
// only attach existing skills, not create new ones inline — anything not
// in the seed list stays in Profile.expertiseAreas as free-text fallback.
model Skill {
  id        String         @id @default(cuid())
  name      String         @unique
  slug      String         @unique
  createdAt DateTime       @default(now())
  profiles  ProfileSkill[]

  @@map("skills")
}

model ProfileSkill {
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([profileId, skillId])
  @@index([skillId])
  @@map("profile_skills")
}

// Rollout phase for public applications (PRD §3.2). Gates whether the
// application form's professional-reference field is required.
enum AdmissionPhase {
  founding_cohort
  referral_driven_growth
  open_applications
}

// Singleton row (fixed id = 1) holding site-wide, admin-editable settings.
// Extend with more columns as future settings (e.g. inactivity threshold,
// §3.4) are added, rather than introducing a generic key/value table.
model SiteSettings {
  id                        Int            @id @default(1)
  admissionPhase            AdmissionPhase @default(referral_driven_growth)
  welcomeAnnouncementInFeed Boolean        @default(true)
  welcomeAnnouncementNotify Boolean        @default(true)
  welcomeAnnouncementEmail  Boolean        @default(true)
  updatedAt                 DateTime       @updatedAt

  @@map("site_settings")
}

enum CareerStage {
  expert
  early_career
  student
}

enum ApplicationAvailability {
  virtual_meeting
  in_person
  online_review
}

// Fixed, admin-curated interest tags shown as a multi-select on both the
// join application and the profile edit page. Supersedes the old, narrower
// AreaOfInterest categorization (healthcare/science/law/business/it),
// removed in favor of this single list.
enum InterestArea {
  arts_crafts
  basic_science_research
  biotechnology
  business
  clinical_research
  culinary_arts
  data_analytics
  e_learning
  education
  finance_investing
  health_wellness
  health_tech
  healthcare
  leadership_management
  literature_writing
  marketing_sales
  science_philosophy
  sustainability_environment
  tech_development
  travel_culture
  music
  history
}

enum ApplicationStatus {
  submitted
  under_review
  approved
  rejected
}

enum TeamRoleBadge {
  founder
  board_member
  partner
}

// Public "Our Team" page content (PRD §4.12), admin-managed. photoUrl stores
// the MinIO object key (not a browser-facing URL) — signed URLs are
// generated per-request since they expire, same rationale as Profile
// avatars once those exist (§4.3).
model TeamMember {
  id           String        @id @default(cuid())
  name         String
  roleBadge    TeamRoleBadge
  title        String
  affiliation  String?
  bio          String
  photoUrl     String?
  displayOrder Int           @default(0)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("team_members")
}

enum DonationFrequency {
  one_time
  recurring
}

// Individual donation record (PRD §4.14). Deliberately has NO relation to
// ContributionLedger or User.tier anywhere in this model or in any code
// path — donations must never confer Knowledge Hours or membership
// advantage. userId is purely a denormalized "who donated" attribution
// (nullable — most donors won't be logged in) and is never read by any
// tier/ledger logic. Rows are created only from the Stripe webhook on
// confirmed payment (app/api/webhooks/stripe/route.ts), never at checkout
// creation time, so a failed/cancelled/expired session never produces one.
model Donation {
  id                      String            @id @default(cuid())
  donorName               String
  donorEmail              String
  userId                  String?
  user                    User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  amountCents             Int
  currency                String            @default("usd")
  frequency               DonationFrequency
  recognitionConsent      Boolean           @default(false)
  emailUpdatesOptIn       Boolean           @default(false)
  note                    String?
  stripeCheckoutSessionId String            @unique
  stripeSubscriptionId    String?
  createdAt               DateTime          @default(now())
  viewedByAdminAt         DateTime?

  @@index([viewedByAdminAt])
  @@map("donations")
}

// A public /contact form submission (PRD §5 IA). Persisted as a durable
// record so a submission survives even if the notification email below
// fails or RESEND_API_KEY isn't configured — the email is the fast path,
// this row is the fallback so nothing is silently lost.
model ContactMessage {
  id        String           @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  services  ContactService[] @default([])
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([readAt])
  @@map("contact_messages")
}

enum ContactService {
  research_curation
  peer_review_feedback
  teaching_sharing
}

// Source selected on the /join form's "How did you hear about NASIHA?"
// field. `member` requires howHeardMemberName; `other` requires
// howHeardOtherDetail — enforced in lib/validation/application.ts, not here.
enum HowHeardSource {
  online_search
  colleague
  member
  other
}

model MembershipApplication {
  id                  String          @id @default(cuid())
  firstName           String
  lastName            String
  email               String
  // Optional as of the join-form field reduction below — the applicant can
  // fill this in later from their Profile (§4.3) instead.
  professionalTitle   String?
  linkedinUrl         String?
  countryRegion       String
  howHeardSource      HowHeardSource?
  // Set only when howHeardSource = member.
  howHeardMemberName  String?
  // Set only when howHeardSource = other.
  howHeardOtherDetail String?

  // ===== Legacy vetting fields =====
  // Collected on /join until the join-form field reduction (applicant now
  // fills these into their Profile post-approval instead, §4.3): the Board
  // reviews and approves/rejects on identity alone (name/email/title/
  // country/how-heard) rather than this detail. Columns kept nullable
  // (rather than dropped) so already-submitted applications retain their
  // historical answers for admin viewing — never populated by new
  // submissions going forward.
  careerStage                  CareerStage?
  availability                 ApplicationAvailability[]
  interestAreas                InterestArea[]
  referral                     String?
  whyJoin                      String?
  expertiseToShare             String?
  topicsToLearn                String?
  professionalReferenceName    String?
  professionalReferenceContact String?

  codeOfConductAcceptedAt DateTime
  emailUpdatesOptIn       Boolean           @default(false)
  status                  ApplicationStatus @default(submitted)

  // True when this application was auto-submitted from the donate form's
  // "also apply as a Friend" checkbox (PRD §4.14) rather than filled out
  // directly on /join — still goes through the same admin review queue,
  // just pre-fills only the fields a donation checkout actually has
  // (name/email), leaving career/interest fields blank for the admin to
  // see as unanswered rather than fabricated.
  sourcedFromDonation Boolean @default(false)

  // Applicant's own tier preference (e.g. "just want Friend of Nasiha access")
  // — a non-binding hint only. It pre-fills the admin's assignedTier selector
  // at review time but the admin can freely override it; assignedTier below
  // remains the sole source of truth for what tier is actually granted.
  requestedTier Tier?

  // Review outcome (PRD §3.3/§4.11). Set once by the admin review action;
  // the application row itself is the audit trail — never deleted, so these
  // stay populated permanently once a decision is made. reviewedByEmail is
  // a denormalized snapshot (not a live FK) since this is a log entry, not
  // a relation that needs to track the reviewer's current identity.
  assignedTier                Tier?
  adminNote                   String?
  adminNoteVisibleToApplicant Boolean   @default(false)
  reviewedAt                  DateTime?
  reviewedByEmail             String?

  // Set whenever a Clerk sign-up invitation is (re)created for this
  // applicant — on initial approve and on every "Resend invite email"
  // click. resendMemberInvitation() revokes any prior pending invitation
  // before creating the new one, so this timestamp marks the point after
  // which only the newest invite email's link still works; shown to the
  // admin so repeat resends don't get triggered without reason.
  lastInvitedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("membership_applications")
}

// Phase 3 data model — Knowledge Hours ledger + Inbox (PRD §4.4/§4.7).
// ContributionRule and ContributionEvent are kept separate from
// ContributionLedger per §4.4/§7: Rule is the configurable rate card,
// Event is the descriptive "what happened" record (who/what/when),
// Ledger is the append-only set of balance-affecting rows. A balance is
// always SUM(ledger.hours WHERE status = confirmed) — never a stored,
// directly-mutated field.
enum LedgerTransactionType {
  earned
  spent
  // No `transferred` — the Charter explicitly prohibits moving Knowledge
  // Hours from one member's balance to another's (§4.4). `adjusted` is
  // the only way a balance changes outside normal earn/spend, and it
  // requires an admin actor + reason (enforced in app code, not the DB).
  adjusted
}

enum LedgerStatus {
  pending
  confirmed
  rejected
}

// Where a ContributionEvent originated (§4.4's hybrid auto/self-report
// model). `event_attendance` rows also carry a real FK via
// ContributionEvent.attendanceId (added once the auto-earn trigger was
// wired up), so this tag is redundant with that link for those rows but
// stays as the uniform discriminator across all sources.
enum ContributionSource {
  event_attendance
  meeting_request
  self_reported
  blog_post
  library_submission
  review_feedback
}

// Configurable earn/spend rate card (§4.4) — not hardcoded, so rates can
// be tuned by the org over time. `hours` is the unsigned magnitude;
// ContributionLedger applies the sign based on `type` when a transaction
// is posted.
model ContributionRule {
  id          String                @id @default(cuid())
  activityKey String                @unique
  label       String
  type        LedgerTransactionType
  hours       Decimal               @db.Decimal(5, 2)
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  events ContributionEvent[]

  @@map("contribution_rules")
}

// The activity occurrence a ledger row is derived from (§4.4): who did
// it, who the counterpart was (if any — peer confirmation target), and
// where it came from. Kept separate from ContributionLedger so a single
// occurrence's descriptive detail isn't duplicated across rows, and so
// admin `adjusted` corrections (which have no originating activity) can
// leave `ContributionLedger.eventId` null.
model ContributionEvent {
  id            String             @id @default(cuid())
  ruleId        String
  rule          ContributionRule   @relation(fields: [ruleId], references: [id])
  actorId       String
  actor         User               @relation("ContributionEventActor", fields: [actorId], references: [id])
  counterpartId String?
  counterpart   User?              @relation("ContributionEventCounterpart", fields: [counterpartId], references: [id])
  note          String?
  source        ContributionSource
  occurredAt    DateTime           @default(now())
  createdAt     DateTime           @default(now())

  // Set only for source = event_attendance: the host's Attendance row that
  // triggered this auto-earn (§4.4/§4.6). The audit-trail link back to the
  // originating Event/Attendance record, one-to-one since a given Attendance
  // row can only ever produce a single earn transaction.
  attendanceId String?     @unique
  attendance   Attendance? @relation(fields: [attendanceId], references: [id])

  // Set only for source = library_submission: the KnowledgeItem whose
  // publish triggered this auto-earn (§4.4/§4.9, blog_post included since
  // Blog's consolidation into the Library — the former source = blog_post
  // rows were repointed here by scripts/migrate-blog-to-library.ts, and
  // the retired postId field/relation this comment used to describe has
  // been dropped along with the Post model tree). Same one-to-one
  // audit-trail pattern as attendanceId — a given KnowledgeItem can only
  // ever produce a single earn transaction, posted at publish time.
  knowledgeItemId String?        @unique
  knowledgeItem   KnowledgeItem? @relation(fields: [knowledgeItemId], references: [id])

  // Set only for source = review_feedback: the reviewer's ReviewComment
  // that triggered this auto-earn (Peer Review & Feedback Knowledge Hours
  // accounting) — the specific *first* comment they posted on a given
  // ReviewItem, not every comment. Same one-to-one audit-trail pattern as
  // postId/knowledgeItemId above.
  reviewCommentId String?        @unique
  reviewComment   ReviewComment? @relation(fields: [reviewCommentId], references: [id])

  ledgerEntries ContributionLedger[]

  @@index([actorId])
  @@index([counterpartId])
  @@map("contribution_events")
}

// The immutable, append-only balance-affecting transaction (§4.4). Never
// updated in place after resolution — status moves pending -> confirmed
// | rejected exactly once. `hours` is signed (positive for earned,
// negative for spent, either sign for an admin `adjusted` correction) so
// a plain SUM() over confirmed rows yields the balance.
model ContributionLedger {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("LedgerUser", fields: [userId], references: [id])

  eventId String?
  event   ContributionEvent? @relation(fields: [eventId], references: [id])

  type   LedgerTransactionType
  status LedgerStatus          @default(pending)
  hours  Decimal               @db.Decimal(5, 2)
  // Required (enforced in app code) when type = adjusted (the admin's
  // correction reason) or when an admin rejects a pending entry in their
  // admin capacity (not as the named counterpart) — same §4.4 audit
  // requirement, reused rather than adding a second reason column.
  reason String?

  // Set only for admin-initiated `adjusted` rows; null for self-reported
  // or auto-posted entries.
  createdByUserId String?
  createdByUser   User?   @relation("LedgerCreatedBy", fields: [createdByUserId], references: [id])

  // The counterpart or admin who confirmed/rejected a pending row. Null
  // for auto-posted rows (confirmed by construction) and while pending.
  resolvedByUserId String?
  resolvedByUser   User?     @relation("LedgerResolvedBy", fields: [resolvedByUserId], references: [id])
  resolvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meetingRequestAsRequesterSpend MeetingRequest? @relation("MeetingRequestRequesterLedger")
  meetingRequestAsRecipientEarn  MeetingRequest? @relation("MeetingRequestRecipientLedger")

  @@index([userId, status])
  @@map("contribution_ledger")
}

// `pending`/`rescheduled` and `reschedule_by_sender`/`reschedule_by_recipient`
// each double as a turn indicator, not just a one-shot status — either party
// can keep proposing new times across unlimited rounds until one side
// accepts/declines:
//   pending     — the sender proposed last (the original request, or a
//                 later counter-proposal); it's the recipient's turn.
//   rescheduled — the recipient proposed last; it's the sender's turn.
// See resolveMeetingRequest's turnHolderId in meeting-requests-server.ts.
// Chosen by the sender at MeetingRequest creation time (Event creation has
// no equivalent persisted field — its choice and room/link creation happen
// in the same request, so nothing needs remembering between steps). A
// MeetingRequest's platform choice has to be persisted because the actual
// room/link isn't created until resolveMeetingRequest() on acceptance,
// which can happen much later and be triggered by either party.
enum MeetingPlatform {
  google_meet
  livekit
}

enum MeetingRequestStatus {
  pending
  accepted
  declined
  rescheduled
  // Either party may cancel an already-accepted meeting (unlike decline,
  // which is the pre-acceptance response to a pending/rescheduled request —
  // available to whichever party currently holds the turn); the original
  // sender may additionally withdraw the whole negotiation outright at any
  // pending/rescheduled turn, not just when it's the recipient's turn.
  // Deletes the Google Calendar event; does not reverse the ContributionLedger
  // rows acceptance already posted.
  cancelled
  // An already-`accepted` meeting with an outstanding proposed new time
  // (§4.7 follow-up) — either party may kick this off at any time (unlike
  // pending/rescheduled, entry into this pair isn't turn-gated, since
  // there's no outstanding proposal yet to take a turn on). Once in one of
  // these two states, the same turn-holder rule as pending/rescheduled
  // applies for accept/decline/counter-propose. `proposedTimes` holds the
  // candidate new time(s); the original `scheduledAt`/`meetingUrl`/
  // `googleEventId` are left untouched (the meeting still happens as
  // scheduled) until accept confirms the new time — see
  // confirmMeetingReschedule in meeting-requests-server.ts. Declining just
  // reverts status to `accepted` with the original time intact. Never
  // touches the ContributionLedger rows the original acceptance already
  // posted — a reschedule is the same engagement at a different time, not a
  // new one.
  reschedule_by_sender
  reschedule_by_recipient
}

// One entry per step of a meeting-request negotiation (§4.7) — the
// original ask, each counter-proposed time, and the final
// accept/decline/cancel — rendered as a timeline in the Inbox detail pane.
// Replaces MeetingRequest's old single mutable `message` column, which got
// silently overwritten (and the original invite text lost) every time
// either party proposed a new time.
enum MeetingRequestMessageAction {
  created
  proposed
  accepted
  declined
  cancelled
  // Freeform follow-up on the thread — doesn't touch MeetingRequest.status,
  // available at any status/turn (unlike the negotiation actions above,
  // which are turn-gated). See resolveMeetingRequest's "message" branch.
  commented
  // System-authored (posted as the meeting's own sender, not a real typed
  // comment) — the compiled LiveKit chat log, inserted once by
  // finalizeMeetingRequestChatTranscript when the room_finished webhook
  // fires. `body` carries the whole stacked "Name — time\nmessage" log;
  // no separate transcript-link model is needed since this row itself is
  // the display unit (see MeetingRequestChatMessage's doc comment).
  chat_transcript
}

model MeetingRequestMessage {
  id               String                      @id @default(cuid())
  meetingRequestId String
  meetingRequest   MeetingRequest              @relation(fields: [meetingRequestId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User                        @relation("MeetingRequestMessageSender", fields: [senderId], references: [id])
  action           MeetingRequestMessageAction
  body             String?
  // Only set for created/proposed — the times on offer as of this step.
  proposedTimes    DateTime[]
  // Read state for the *other* party (a meeting request is always strictly
  // two-party, so unlike InboxMessage there's no separate recipientId column
  // needed — "the other party" is fully determined by senderId plus the
  // MeetingRequest's own sender/recipient). Null until the other party opens
  // the meeting request detail view.
  readAt           DateTime?
  createdAt        DateTime                    @default(now())

  @@index([meetingRequestId, createdAt])
  @@index([senderId, readAt])
  @@map("meeting_request_messages")
}

// Directory-originated meeting request (§4.7) — always two-party, no
// conversation/participant join tables needed. Accepting one posts two
// ledger rows (§4.4/§11's resolved open question #12): an auto-confirmed
// spend for the requester (system has full ground truth — both parties
// already interacted to reach acceptance), and a system-generated but
// still `pending` earn for the recipient, naming the requester as
// counterpart. The recipient's earn isn't auto-confirmed like the spend
// side — requiring the requester's peer confirmation is a deliberate
// anti-fraud check, so the recipient can't unilaterally credit
// themselves for a meeting.
model MeetingRequest {
  id            String                  @id @default(cuid())
  senderId      String
  sender        User                    @relation("MeetingRequestSender", fields: [senderId], references: [id])
  recipientId   String
  recipient     User                    @relation("MeetingRequestRecipient", fields: [recipientId], references: [id])
  topic         String
  // The current outstanding proposed time(s) — kept alongside the full
  // negotiation history in `messages` because resolveScheduledTime() needs
  // a quick "what's on the table right now" without walking the log.
  proposedTimes DateTime[]
  status        MeetingRequestStatus    @default(pending)
  messages      MeetingRequestMessage[]

  // Set on acceptance — the single confirmed time (chosen from
  // proposedTimes) and the Google Meet link/event id auto-generated for it
  // via the app-owned Gmail account (web/lib/google-calendar.ts). meetingUrl
  // stays null if that call fails or isn't configured — never blocks
  // acceptance itself.
  scheduledAt                     DateTime?
  meetingUrl                      String?
  googleEventId                   String?
  // Chosen by the sender at creation time (LiveKit Meeting Infrastructure
  // initiative) — consulted by resolveMeetingRequest() on acceptance to
  // decide which platform to create the room/link on. Defaults to
  // google_meet, preserving today's only behavior for existing rows.
  meetingPlatform                 MeetingPlatform           @default(google_meet)
  // Set instead of meetingUrl/googleEventId when meetingPlatform is
  // livekit — non-null is the authoritative signal that this meeting is
  // LiveKit-backed, read by the in-app meeting page and recording webhook.
  livekitRoomName                 String?
  // Set by lib/meeting-recordings-sync.ts once Google finishes processing
  // the recording (§ recording-by-default) — a MeetingRequest is always a
  // one-off meeting, so unlike Event's EventRecording[] a single column is
  // enough (no per-occurrence disambiguation needed).
  recordingUrl                    String?
  // The recording's Drive fileId, alongside recordingUrl — see
  // EventRecording.driveFileId's comment for why this is needed separately
  // from the playback link.
  driveFileId                     String?
  // LiveKit-only segments (objective 4) — see MeetingRequestRecording's
  // doc comment for why these live in a separate child table instead of
  // recordingUrl/driveFileId above.
  recordings                      MeetingRequestRecording[]
  // LiveKit in-meeting chat archival — staged messages captured while the
  // meeting is live, compiled by finalizeMeetingRequestChatTranscript into
  // a single MeetingRequestMessage (action: chat_transcript) in `messages`
  // above once the room ends. No occurrence linking needed here, unlike
  // Event's EventChatTranscript — a MeetingRequest's room is used exactly
  // once, same reasoning recordingUrl's own comment already gives.
  chatMessages                    MeetingRequestChatMessage[]
  // In-app waiting-room feature — same shape/semantics as Event's fields
  // above. Organizer = sender for a MeetingRequest (matches every other
  // sender-privileged action in this model).
  meetingStartedAt                DateTime?
  // Same semantics as Event.meetingEndedAt — see its comment.
  meetingEndedAt                  DateTime?
  meetingOrganizerMessage         String?
  meetingOrganizerMessageImageKey String?

  // Set on acceptance — the requester's auto-confirmed spend row. Null
  // until accepted (declined/rescheduled requests never get one).
  contributionLedgerId String?             @unique
  contributionLedger   ContributionLedger? @relation("MeetingRequestRequesterLedger", fields: [contributionLedgerId], references: [id])

  // Set on acceptance — the recipient's system-generated, pending-until-
  // the-requester-confirms earn row. Same lifecycle as any other
  // counterpart-confirmed entry (§4.4) once created; only its *creation*
  // is automatic here, not its confirmation.
  recipientContributionLedgerId String?             @unique
  recipientContributionLedger   ContributionLedger? @relation("MeetingRequestRecipientLedger", fields: [recipientContributionLedgerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipientId, status])
  @@index([senderId])
  @@map("meeting_requests")
}

// Directory-originated asynchronous message (§4.7). Threaded replies are
// a self-relation via parentId, email-style — not a live conversation.
model InboxMessage {
  id          String  @id @default(cuid())
  senderId    String
  sender      User    @relation("InboxMessageSender", fields: [senderId], references: [id])
  recipientId String
  recipient   User    @relation("InboxMessageRecipient", fields: [recipientId], references: [id])
  subject     String?
  body        String

  parentId String?
  parent   InboxMessage?  @relation("InboxMessageThread", fields: [parentId], references: [id])
  replies  InboxMessage[] @relation("InboxMessageThread")

  readAt    DateTime?
  createdAt DateTime  @default(now())

  // Images pasted into this message's body — see PastedImage.
  pastedImages PastedImage[]

  @@index([recipientId, readAt])
  @@index([senderId])
  @@index([parentId])
  @@map("inbox_messages")
}

// §4.10's notification types this objective's entities can produce
// directly; the remaining types (digest/board announcement) get
// added when those domains land in later phases. blog_comment/
// forum_reply_mention/resource_review_update were added once Blog,
// Knowledge Library, and Forums (§4.8/§4.9/§4.13) landed in Phase 5.
// digest/board_announcement added in Phase 6 (§4.10) — digest batching and
// announcement-sending jobs are separate later objectives; this only adds
// the enum values NotificationPreference/Announcement need to reference.
// event_invited added for the audience-restricted group-events initiative
// (Objective 01) — sent to each invitee when an organizer restricts an
// Event to a specific list rather than the whole community; unlike
// meeting_request_*, community/open events never produce a Notification.
enum NotificationType {
  inbox_message
  meeting_request_received
  meeting_request_accepted
  meeting_request_declined
  meeting_request_rescheduled
  meeting_request_cancelled
  // Freeform follow-up comment posted on a meeting-request thread — distinct
  // from the lifecycle notifications above, which only fire on a
  // status-changing action.
  meeting_request_message
  contribution_awarded
  // Sent to the named counterpart of a pending ContributionLedger entry
  // (self-reported log, accepted meeting's earn side, or review feedback)
  // — the "please confirm these Knowledge Hours" ping. Distinct from
  // contribution_awarded, which fires once an entry is already confirmed.
  contribution_confirmation_requested
  // Sent to the entry's submitter (resolveContribution) when a peer or
  // admin rejects their pending contribution — the rejection counterpart
  // to contribution_awarded, which covers the confirm outcome.
  contribution_rejected
  // Sent to the named counterpart of a pending entry when an *admin*
  // resolves it instead of them (confirm or reject either one, message
  // text distinguishes) — without this, the entry just silently
  // disappears from their "awaiting your confirmation" dashboard widget
  // with no explanation of what happened to it.
  contribution_resolved_by_admin
  blog_comment
  forum_reply_mention
  // Explicit @Name tag (§4.8/§4.13) — distinct from forum_reply_mention
  // (which despite its name is the "other thread participants" reply
  // notification) and blog_comment (the post-author notification).
  mention
  resource_review_update
  digest
  board_announcement
  survey_invitation
  event_invited
  // Bell-only (no paired email, unlike event_invited) — sent to a
  // restricted event's host each time an invitee RSVPs going or
  // not-going (Objective 02). Community events never produce this.
  event_rsvp_response
  // Objective 03 — sent to a member removed from a restricted event's
  // invited list after creation (paired with email, like event_invited).
  event_removed
  // Objective 03 — sent to every current invitee when the host cancels a
  // restricted event (paired with email).
  event_cancelled
  // Objective 03 — sent to every current invitee when the host changes a
  // restricted event's startsAt/endsAt (paired with email).
  event_rescheduled
  // Sent to every member (not just this event's invitees — there are none,
  // it's public) when a host schedules a new community-visibility event.
  // Paired with email, mirrors board_announcement's all-members broadcast
  // but scoped to one event rather than a Board-authored post.
  event_published
  // Restricted Knowledge Library Submissions — sent to a newly-added
  // invitee of a restricted, already-published library item (paired with
  // email, like event_invited). Never fires for a still-pending_review
  // item — no notification until the item is actually visible.
  library_item_shared
  // Sent to a member removed from a restricted library item's invited
  // list (paired with email, like event_removed). No link — a removed
  // invitee loses access to the item's detail page.
  library_item_removed
  // Member-Initiated Restricted Forum Threads (§4.13/§11.16) — sent to a
  // newly-added invitee of a restricted standalone thread, both at
  // creation and via updateForumThreadInvitees. No paired email (unlike
  // event_invited/library_item_shared) — forums have no existing
  // lifecycle-email precedent to extend.
  forum_thread_invited
  // Sent to a member removed from a restricted thread's invited list
  // (mirrors library_item_removed). No link — a removed invitee's next
  // request for the thread 404s.
  forum_thread_removed
  // Peer Review & Feedback — sent to a newly-added invitee of a ReviewItem,
  // both at creation and when a volunteer offer is accepted (paired with
  // email, like library_item_shared).
  peer_review_invited
  // Sent to a ReviewItem's submitter and every other invitee (not the
  // author) when a new ReviewComment is posted.
  peer_review_comment
  // Sent to a member removed from a ReviewItem's invited list (mirrors
  // library_item_removed). No link — a removed invitee's next request
  // for the item 404s.
  peer_review_removed
  // Sent to a ReviewItem's submitter when a member offers to volunteer
  // as a reviewer (open-call mode).
  peer_review_volunteer_offered
  // Sent to a volunteer when the submitter declines their offer — a
  // gentle notice, not silence, so it doesn't feel like a black hole.
  peer_review_volunteer_declined
}

// Homegrown in-app notification feed (§4.10) — no third-party vendor.
// NotificationPreference/Announcement (opt-out prefs + board broadcasts)
// were out of scope for Phase 3.1's entity list and landed in Phase 6.
model Notification {
  id          String           @id @default(cuid())
  recipientId String
  recipient   User             @relation(fields: [recipientId], references: [id])
  type        NotificationType
  message     String
  link        String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([recipientId, readAt])
  @@map("notifications")
}

// Phase 4 data model — Events & Calendar (PRD §4.6). Data foundation only;
// FullCalendar rendering, "Submit Event," and RSVP UI land in later
// objectives. Extensible enum per §4.6 (new types can be added later).
enum EventType {
  webinar
  workshop
  case_discussion
  student_event
  roundtable
  lecture
  group_meeting
}

enum RecurrenceFrequency {
  daily
  weekly
  monthly
}

enum RSVPStatus {
  going
  cancelled
}

// "Audience-Restricted Group Events" initiative, Objective 01. `community`
// (the only behavior that existed before this) is visible to the whole
// membership, unconditionally; `invited` is visible only to the host and
// the members listed in EventInvitee — enforced in every member-facing
// query in lib/events-server.ts/lib/feed-server.ts, never in the DB layer.
// Admin-facing reporting (getEventEngagementForAdmin) is deliberately
// exempt from this restriction.
enum EventVisibility {
  community
  invited
}

// Distinguishes a host's attendance (the §4.4/§4.6 auto-earn trigger) from
// a regular attendee's attendance record within the same table.
enum AttendanceRole {
  host
  attendee
}

// Event listing/calendar entry (§4.6). `open` gates public (§4.5 unauthenticated
// /events) vs. members-only visibility; `meetingUrl` is stored regardless but
// only ever served to RSVP'd members (enforced in API routes, not here) — the
// public listing itself never gets it. A signed-out visitor registering for
// an `open` event via EventRegistration (registerForEvent, events-server.ts)
// is the one exception — that's a deliberate signal of intent to attend, so
// the confirmation email does include meetingUrl even though nothing ever
// displays it on the page. `deidentificationConfirmed` must be true
// before a case_discussion event can be published — also app-enforced (same
// pattern as MembershipApplication's phase-conditional required fields),
// since the rule depends on `type` and isn't expressible as a DB constraint.
model Event {
  id                              String          @id @default(cuid())
  title                           String
  description                     String?
  type                            EventType
  hostId                          String
  host                            User            @relation("EventHost", fields: [hostId], references: [id])
  startsAt                        DateTime
  endsAt                          DateTime?
  // IANA zone (e.g. "America/New_York") captured from the submitting
  // member's browser at create/edit time — startsAt/endsAt are stored as
  // UTC instants, so this is the only record of which wall-clock time the
  // organizer actually meant. Notification/email "when" text formats
  // against this rather than the server's own timezone (previously
  // omitted entirely, which silently rendered in the server process's
  // timezone instead of the organizer's). Nullable so pre-existing rows
  // from before this field existed fall back to a fixed default at format
  // time rather than needing a backfill.
  timezone                        String?
  open                            Boolean         @default(false)
  heroImageUrl                    String?
  meetingUrl                      String?
  // Set only when meetingUrl was auto-generated via createMeetingCalendarEvent
  // (google-calendar.ts) for an `invited`-visibility event — needed so a
  // later objective (invite-list edits, cancel/reschedule) can update or
  // delete the underlying Google Calendar event. Null for a manually-entered
  // meetingUrl or for community events, which never call Google.
  googleEventId                   String?
  // Set instead of meetingUrl/googleEventId when the host chose LiveKit as
  // meetLinkSource at creation time (LiveKit Meeting Infrastructure
  // initiative) — non-null is the authoritative signal that this event's
  // meeting is LiveKit-backed, read by the in-app meeting page and
  // recording webhook.
  livekitRoomName                 String?
  // In-app waiting-room feature: null until the host clicks "Start Meeting"
  // on the /meet/event/[id] page — presence means "live", triggering
  // waiting attendees' auto-redirect to the real Meet link.
  meetingStartedAt                DateTime?
  // Set by resetMeetingOnRoomEmpty (lib/livekit.ts) when LiveKit's
  // room_finished webhook fires — the room's real emptyTimeout-based
  // close, not the event's scheduled endsAt. Cleared back to null by
  // startEventMeeting on the next "Start Meeting" click, so its presence
  // unambiguously means "started, then genuinely ended" rather than
  // "never started" (both fields null covers that case). Only ever set
  // for LiveKit-backed events — Meet gives no equivalent server-side
  // signal, so Meet-backed events keep gating on scheduled time instead.
  meetingEndedAt                  DateTime?
  meetingOrganizerMessage         String?
  meetingOrganizerMessageImageKey String?
  // Audience-Restricted Group Events, Objective 01 (§4.6 extension) —
  // `community` preserves every pre-existing event's behavior unchanged.
  visibility                      EventVisibility @default(community)
  // Objective 03 — soft-delete-style one-way flag (mirrors
  // Announcement.retractedAt's existing convention) rather than a status
  // enum, since there's nothing to transition back from. Every
  // visibility-filtered query excludes a cancelled event entirely; the
  // "Cancel Event" action is only exposed in the UI for a restricted
  // event, so this never gets set on a community event today even though
  // the field/filtering is generic.
  cancelledAt                     DateTime?
  deidentificationConfirmed       Boolean         @default(false)
  createdAt                       DateTime        @default(now())
  updatedAt                       DateTime        @updatedAt

  recurrence    EventRecurrence?
  rsvps         RSVP[]
  attendances   Attendance[]
  registrations EventRegistration[]
  // Only populated for visibility = invited — who was asked, distinct from
  // RSVP (who responded). Supports add/remove after creation (a later
  // objective), not just bulk-insert at createEvent() time.
  invitees      EventInvitee[]
  // Recording Access initiative — separate from `invitees`: co-hosts must
  // work for community/open events too, which have no EventInvitee rows.
  // Assigned by the host at scheduling time; the host or an existing
  // co-host can also grant/revoke it live during the meeting.
  coHosts       EventCoHost[]
  // Optional discussion thread in the seeded "Events" forum (EVENTS_FORUM_SLUG,
  // lib/forums.ts), opted into at creation time. The FK lives on ForumThread
  // (below) rather than here so createEvent can create the Event first and
  // still know its id when posting the thread's linking first post.
  forumThread   ForumThread?
  // Unique-visitor count for the event detail page's eye-icon (mirrors
  // ThreadView) — events are member-only like forums, so this dedupes on
  // real userId rather than an opaque viewer key like PostView does.
  views         EventView[]
  // Every meeting held over an auto-generated Meet link is recorded by
  // default (lib/google-calendar.ts) — one row per occurrence, since a
  // recurring event reuses the same Meet space/link across every session.
  recordings    EventRecording[]
  // Resend Notifications — the audit trail of every member-wide broadcast
  // for this event (the automatic one at creation, plus any manual resend
  // the organizer/admin triggers from the event detail page).
  notificationBroadcasts EventNotificationBroadcast[]
  // LiveKit in-meeting chat archival — staged messages captured while the
  // meeting is live (EventChatMessage), compiled into a single ForumPost
  // per occurrence when the room ends and linked back via
  // EventChatTranscript so the event page can jump straight to it.
  chatMessages    EventChatMessage[]
  chatTranscripts EventChatTranscript[]

  @@index([startsAt])
  @@map("events")
}

// Audit trail for member-wide event broadcasts (Resend Notifications,
// event-detail page) — one row per send: the automatic one createEvent()
// fires for a new community event, plus any manual resend an organizer/
// admin triggers afterward. Deliberately separate from the per-recipient
// Notification rows themselves, which a member can delete once read
// (clearReadNotifications) — this is the durable, organizer-facing record
// of when a broadcast went out and to how many people, independent of what
// any individual recipient later does with their own copy.
model EventNotificationBroadcast {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sentById       String
  sentBy         User     @relation("EventNotificationBroadcastSentBy", fields: [sentById], references: [id])
  recipientCount Int
  sentAt         DateTime @default(now())

  @@index([eventId, sentAt])
  @@map("event_notification_broadcasts")
}

// A finished recording for one occurrence of an Event's meeting. Two
// origins share this table (LiveKit Meeting Infrastructure, objective 4):
// `meet` rows are discovered after the fact by lib/meeting-recordings-sync.ts
// polling the Meet API (Google processes a recording asynchronously — no
// way to get the link at creation time), one row per occurrence, upsert-
// guarded in application logic (not a DB constraint — see below) via a
// `findFirst` on [eventId, occurrenceDate]. `livekit` rows are pushed by
// the egress_ended webhook (lib/livekit.ts) and are NOT one-per-occurrence:
// LiveKit's egress API has no pause/resume, so an attendee repeatedly
// starting/stopping the in-meeting Record control produces one row per
// segment, ordered by `startedAt` and presented together as "Part 1",
// "Part 2", etc. wherever a meeting's recording(s) are surfaced.
//
// The unique index that used to guarantee exactly one row per
// [eventId, occurrenceDate] was dropped for this reason — it would reject
// every segment after the first for a livekit-origin meeting. Meet's own
// one-row-per-occurrence guarantee still holds; it's just enforced by
// meeting-recordings-sync.ts's own existence check instead of the DB.
model EventRecording {
  id             String          @id @default(cuid())
  eventId        String
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  occurrenceDate DateTime
  origin         RecordingOrigin @default(meet)
  // --- meet origin only ---
  // Drive playback link. The recording's Drive fileId
  // (Recording.driveDestination.file, distinct from recordingUrl's
  // playback link) is needed to actually delete the file via the Drive API
  // when the host removes a recording, not just unlink it.
  recordingUrl   String?
  driveFileId    String?
  // --- livekit origin only ---
  // MinIO object key for this segment (not a URL — see the streaming
  // route's doc comment in app/api/events/[id]/recording/[recordingId]/route.ts
  // for why a stored URL/presigned-URL would be wrong here).
  objectKey      String?
  // LiveKit's egress id for this segment — unique (Postgres allows
  // unlimited NULLs on a unique nullable column, so meet-origin rows with
  // no egressId don't collide with each other), lets the egress_ended
  // webhook be replay-safe (upsert on egressId instead of blindly
  // inserting a duplicate row on a redelivered webhook).
  egressId       String?         @unique
  // When this segment's egress actually started — the ordering key for
  // "Part 1"/"Part 2" grouping, since createdAt only reflects when the
  // webhook happened to arrive.
  startedAt      DateTime?
  // Set by the egress_ended webhook when LiveKit reports EGRESS_FAILED/
  // EGRESS_ABORTED/no file result — distinguishes "still processing"
  // (objectKey null, failedAt null) from "genuinely failed" (failedAt
  // set), so the UI never shows a permanently-stuck processing indicator.
  failedAt       DateTime?
  // From the egress_ended webhook's FileInfo.duration (nanoseconds on the
  // wire, converted to seconds). Null until the webhook lands, same as
  // objectKey — a pending/failed segment has no duration yet.
  durationSeconds Int?
  createdAt      DateTime        @default(now())

  @@index([eventId, occurrenceDate])
  @@map("event_recordings")
}

// Short-lived staging row for one LiveKit in-meeting chat message, captured
// live via POST /api/events/[id]/meeting/chat as each participant's own
// client reports messages it sent (never messages claimed on behalf of
// another participant — see ChatCaptureListener's doc comment). Deleted by
// finalizeEventChatTranscript once compiled into a ForumPost when the
// room_finished webhook fires; a lingering row past that point means
// finalization hasn't run yet (or the event has no forumThreadId, in which
// case rows are still cleared but nothing gets posted).
model EventChatMessage {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // LiveKit's own per-message id (ReceivedChatMessage.id) — the dedupe key
  // that makes a retried/re-effect-fired POST an idempotent no-op.
  livekitMessageId String
  // Display-name snapshot at send time, not a live User join — a guest
  // attendee has no User row at all, and even a member's name could change
  // later; the transcript should read as it did at meeting time either way.
  authorName   String
  authorUserId String?
  body         String
  sentAt       DateTime
  createdAt    DateTime @default(now())

  @@unique([eventId, livekitMessageId])
  @@index([eventId])
  @@map("event_chat_messages")
}

// Links a compiled chat-transcript ForumPost back to the specific event
// occurrence it belongs to. Needed because a recurring event has one
// persistent LiveKit room shared across every occurrence (Event.id ===
// Event.livekitRoomName, not one room per occurrence) — same reason
// EventRecording needs its own occurrenceDate rather than relying on
// Event.startsAt. Read by getMemberEventById to resolve the "View chat
// transcript" link for the occurrence currently being viewed.
model EventChatTranscript {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  occurrenceDate DateTime
  forumPostId    String
  createdAt      DateTime @default(now())

  @@index([eventId, occurrenceDate])
  @@map("event_chat_transcripts")
}

// LiveKit-only counterpart to EventRecording's `livekit` rows, for a
// MeetingRequest's one-off meeting. Doesn't reuse MeetingRequest's existing
// recordingUrl/driveFileId columns — those are single nullable columns
// (a MeetingRequest is always one-off, so Meet's single recording fits in
// one column) and can't hold more than one LiveKit segment; those columns
// stay untouched and keep serving Meet-path recordings exactly as before.
model MeetingRequestRecording {
  id               String         @id @default(cuid())
  meetingRequestId String
  meetingRequest   MeetingRequest @relation(fields: [meetingRequestId], references: [id], onDelete: Cascade)
  // Nullable as of the pending-row-at-Record-click change — null until the
  // egress_ended webhook fills it in. See EventRecording.objectKey's
  // sibling comment for why a stored URL/presigned-URL would be wrong.
  objectKey        String?
  egressId         String         @unique
  startedAt        DateTime
  // Same semantics as EventRecording.failedAt — see its comment.
  failedAt         DateTime?
  // Same semantics as EventRecording.durationSeconds — see its comment.
  durationSeconds  Int?
  createdAt        DateTime       @default(now())

  @@index([meetingRequestId])
  @@map("meeting_request_recordings")
}

// Short-lived staging row for one LiveKit in-meeting chat message on a
// MeetingRequest's 1:1 call — exact mirror of EventChatMessage, keyed on
// meetingRequestId instead of eventId. Deleted by
// finalizeMeetingRequestChatTranscript once compiled into a single
// MeetingRequestMessage when the room_finished webhook fires.
model MeetingRequestChatMessage {
  id               String         @id @default(cuid())
  meetingRequestId String
  meetingRequest   MeetingRequest @relation(fields: [meetingRequestId], references: [id], onDelete: Cascade)
  livekitMessageId String
  authorName       String
  authorUserId     String?
  body             String
  sentAt           DateTime
  createdAt        DateTime       @default(now())

  @@unique([meetingRequestId, livekitMessageId])
  @@index([meetingRequestId])
  @@map("meeting_request_chat_messages")
}

enum RecordingOrigin {
  meet
  livekit
}

// One row per unique member visit to an Event's detail page, for the
// eye-icon view count on /calendar/[eventId] — mirrors ThreadView. Events
// are member-only like forums (no anonymous-visitor case), so this dedupes
// by User.id directly rather than PostView's opaque viewerKey string.
model EventView {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@map("event_views")
}

// Recurrence rule for a recurring Event (§4.6's "recurring events" feature).
// One row per recurring master; individual occurrences aren't materialized
// as separate Event rows — the calendar renderer (a later objective) expands
// them from this rule at render time.
model EventRecurrence {
  id        String              @id @default(cuid())
  eventId   String              @unique
  event     Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  frequency RecurrenceFrequency
  interval  Int                 @default(1)
  // Days of week the recurrence repeats on (0 = Sunday .. 6 = Saturday),
  // for weekly frequency only; ignored for daily/monthly.
  byWeekday Int[]               @default([])
  until     DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@map("event_recurrences")
}

model RSVP {
  id        String     @id @default(cuid())
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation("EventRsvp", fields: [userId], references: [id], onDelete: Cascade)
  status    RSVPStatus @default(going)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([eventId, userId])
  @@index([userId])
  @@map("rsvps")
}

// Who was invited to a visibility = invited Event (§4.6 extension, Objective
// 01) — distinct from RSVP (who responded). One row per invited member;
// rows are added/removed independently of RSVP, which a later objective
// creates/deletes in step with this table (removing an invitee also drops
// their RSVP, if any).
model EventInvitee {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("EventInvitee", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_invitees")
}

// Recording Access initiative — who besides the host (Event.hostId) can
// start/stop LiveKit recording, and grant/revoke further co-hosts, both
// before and during the meeting. Deliberately separate from EventInvitee,
// which only exists for visibility = invited and doesn't cover
// community/open attendees. The DB row is the authoritative source of
// truth (not LiveKit's ephemeral room state) — see lib/livekit.ts's
// coHostUserIds room-metadata field, which only mirrors this for live
// client sync, and web/app/api/events/[id]/meeting/co-hosts/route.ts.
model EventCoHost {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("EventCoHost", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_co_hosts")
}

// Captures a non-member's email (and optional name) when they register
// interest in an `open` event from the public /events page, without
// requiring a User account. Deliberately separate from RSVP: RSVP is
// member-only and feeds Attendance/Knowledge Hours, while this is just a
// lead-capture record for later membership-campaign outreach (no userId —
// same nullable-account-capture precedent as Donation/MembershipApplication).
model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email     String
  name      String?
  createdAt DateTime @default(now())

  @@unique([eventId, email])
  @@index([email])
  @@map("event_registrations")
}

// Records that a user actually attended (vs. merely RSVP'd). A `host`-role
// row is the trigger for the §4.4 auto-posted Knowledge Hours earn
// transaction; `attendee`-role rows are just a record.
model Attendance {
  id             String         @id @default(cuid())
  eventId        String
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation("EventAttendance", fields: [userId], references: [id], onDelete: Cascade)
  role           AttendanceRole @default(attendee)
  // Which occurrence of a recurring event this attendance is for — equals
  // the event's own startsAt for a non-recurring event. Part of the unique
  // key below so a recurring host earns Knowledge Hours once per session
  // instead of once ever for the whole series (see EventRecurrence comment).
  occurrenceDate DateTime
  checkedInAt    DateTime       @default(now())
  createdAt      DateTime       @default(now())

  // Set only for a host-role row, once the auto-earn transaction has been
  // posted (§4.4/§4.6). The other direction of ContributionEvent.attendanceId.
  contributionEvent ContributionEvent?

  @@unique([eventId, userId, occurrenceDate])
  @@index([eventId])
  @@map("attendance")
}

// Phase 5 data model — Knowledge Library & Forums (PRD §4.9/§4.13). Blog
// (§4.8) was consolidated into the Library as the blog_post content type;
// its old Post/PostCategory/PostTag/PostComment/PostView model tree lived
// here until the cleanup migration that retired it.

// ===== Knowledge Library (§4.9) =====

// Library Steward review workflow (§4.9) — only `published` items are
// searchable/browsable; `pending_review` is visible to the submitter and to
// Stewards/admins; `flagged` items stay visible per the "community flagging,
// not formal peer review" model until a Steward removes them.
enum KnowledgeStatus {
  pending_review
  published
  flagged
  rejected
}

// Drives the "recorded lecture uses youtubeUrl instead of a
// KnowledgeAttachment" rule (§4.9) and the Library's content-type filter.
// `blog_post` is the former standalone Blog domain (§4.8), folded in as a
// content type once Blog was consolidated into the Library — it uses
// KnowledgeItem.body instead of an attachment/externalUrl/youtubeUrl.
enum KnowledgeContentType {
  recorded_lecture
  article
  case_study
  guideline
  blog_post
}

// "Career-stage level" filter (§4.9) — the level *the content targets*, not
// the contributor's own career stage (see the existing CareerStage enum),
// and includes an "all levels" option that enum has no equivalent for.
enum KnowledgeLevel {
  student_friendly
  early_career
  advanced
  all_levels
}

// Restricted Knowledge Library Submissions initiative, Objective 01.
// `public` preserves every pre-existing item's behavior unchanged (visible
// to the whole membership once published, same as today). `restricted` is
// visible only to the contributor, the invitees listed in
// KnowledgeItemInvitee, and Steward/admin reviewers — enforced in every
// member-facing query in lib/library-server.ts/lib/feed-server.ts, never in
// the DB layer. Applies only once status reaches published/flagged — the
// Steward moderation gate (KnowledgeStatus) is unaffected, restriction is
// layered on top of it, not a bypass of it. Excluded from Meilisearch
// entirely (search-index-sync.ts) — an invitee finds a restricted item only
// via the regular browse/detail queries, not search-as-you-type.
// Create-only, mirroring Event.visibility — nothing in the edit path
// (updateKnowledgeItem) ever changes it after creation.
enum KnowledgeVisibility {
  public
  restricted
}

model KnowledgeCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  items       KnowledgeItemCategory[]
  reviewItems ReviewItemCategory[]

  @@map("knowledge_categories")
}

// A KnowledgeItem can belong to more than one category (§4.9) — same
// many-to-many join shape as KnowledgeItemTag, just against
// KnowledgeCategory instead of KnowledgeTag.
model KnowledgeItemCategory {
  knowledgeItemId String
  knowledgeItem   KnowledgeItem     @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  categoryId      String
  category        KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([knowledgeItemId, categoryId])
  @@index([categoryId])
  @@map("knowledge_item_categories")
}

model KnowledgeTag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  items       KnowledgeItemTag[]
  reviewItems ReviewItemTag[]

  @@map("knowledge_tags")
}

model KnowledgeItemTag {
  knowledgeItemId String
  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  tagId           String
  tag             KnowledgeTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([knowledgeItemId, tagId])
  @@index([tagId])
  @@map("knowledge_item_tags")
}

// Searchable/filterable resource repository entry (§4.9). `deidentificationConfirmed`
// is required (app-enforced, same pattern as MembershipApplication/Event)
// before a case_study item can leave pending_review. recorded_lecture items
// store `youtubeUrl` instead of a KnowledgeAttachment — Nasiha hosts the
// listing, not the media, mirroring Event.meetingUrl's Zoom/Meet pattern.
model KnowledgeItem {
  id                        String               @id @default(cuid())
  title                     String
  description               String
  // Full rich-text (Tiptap) article content — populated only for
  // contentType = blog_post (and any future long-form type). `description`
  // stays the short excerpt shown on cards/search, auto-derived from this
  // via excerptFromHtml, same split Blog's Post.body/excerpt had.
  body                      String?
  contentType               KnowledgeContentType
  status                    KnowledgeStatus      @default(pending_review)
  level                     KnowledgeLevel
  visibility                KnowledgeVisibility  @default(public)
  contributorId             String
  contributor               User                 @relation("KnowledgeContributor", fields: [contributorId], references: [id])
  youtubeUrl                String?
  // Optional cover image (§4.9), same object-storage-key convention as
  // Event/Post/Announcement/Survey.heroImageUrl. For a recorded_lecture
  // item this is an override, not a requirement — the browse card/detail
  // page/feed fall back to the video's YouTube thumbnail when it's null,
  // so leaving it blank is a legitimate "just use the default" choice, not
  // a missing-data state.
  heroImageUrl              String?
  // Alternative to a KnowledgeAttachment for article/case_study/guideline
  // items — a link to a resource hosted elsewhere (e.g. a Google Doc),
  // mutually exclusive with an attachment, same "store the link, not the
  // binary" idea as youtubeUrl.
  externalUrl               String?
  deidentificationConfirmed Boolean              @default(false)
  licenseConsented          Boolean              @default(false)
  // Required reason the flagging member gave (§4.9) — same "flag is
  // one-way for the flagger, only a Steward resolving it clears this"
  // convention as Post.flagReason.
  flagReason                String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  categories              KnowledgeItemCategory[]
  tags                    KnowledgeItemTag[]
  attachments             KnowledgeAttachment[]
  // On-demand discussion thread in the Research & Resources forum (§4.9),
  // started by any member from /library/[id]'s "Start a Discussion" button
  // — unlike Event's opt-in-at-creation checkbox, since not every resource
  // warrants discussion. The FK lives on ForumThread, same split as Event.
  forumThread             ForumThread?
  // The other direction of ContributionEvent.knowledgeItemId.
  contributionEvent       ContributionEvent?
  // Unique-visitor count for the item detail page's eye-icon (mirrors
  // EventView) — the Library is member-only like Events, so this dedupes on
  // real userId rather than an opaque viewer key like PostView does.
  views                   KnowledgeItemView[]
  invitees                KnowledgeItemInvitee[]
  // Set when this item originated as a closed Peer Review & Feedback
  // submission published via publishReviewItemToLibrary — the other
  // direction of ReviewItem.publishedKnowledgeItem.
  publishedFromReviewItem ReviewItem?
  // The other direction of LegacyBlogSlug.knowledgeItem — populated only
  // for blog_post items created by the Blog-to-Library migration script.
  legacyBlogSlugs         LegacyBlogSlug[]
  // Images pasted into this item's blog_post body — see PastedImage.
  pastedImages            PastedImage[]

  @@index([contributorId])
  @@index([status])
  @@map("knowledge_items")
}

// Who was invited to a visibility = restricted KnowledgeItem — mirrors
// EventInvitee exactly. One row per invited member; rows are added/removed
// independently after creation via updateKnowledgeItemInvitees. No RSVP
// analog exists for the Library (nothing to respond to), so unlike
// EventInvitee this table has no corresponding "response" table to keep
// in step with.
model KnowledgeItemInvitee {
  id              String        @id @default(cuid())
  knowledgeItemId String
  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation("KnowledgeItemInvitee", fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([knowledgeItemId, userId])
  @@index([userId])
  @@map("knowledge_item_invitees")
}

// One row per unique member visit to a KnowledgeItem's detail page, for the
// eye-icon view count on /library/[id] — mirrors EventView. The Library is
// member-only like Events (no anonymous-visitor case), so this dedupes by
// User.id directly rather than PostView's opaque viewerKey string.
model KnowledgeItemView {
  id              String        @id @default(cuid())
  knowledgeItemId String
  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([knowledgeItemId, userId])
  @@map("knowledge_item_views")
}

// Document/article/case-study binary only — never video (recorded lectures
// use KnowledgeItem.youtubeUrl instead, §4.9). `objectKey` is a MinIO key in
// the documents/ bucket, same "not a servable URL" convention as
// Profile.avatarUrl.
model KnowledgeAttachment {
  id              String        @id @default(cuid())
  knowledgeItemId String
  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  objectKey       String
  fileName        String
  mimeType        String
  sizeBytes       Int
  createdAt       DateTime      @default(now())

  @@index([knowledgeItemId])
  @@map("knowledge_attachments")
}

// Redirect-only lookup for old /blog/[slug] URLs, populated by the one-time
// Blog-to-Library data migration script (never written by app code) —
// standalone rather than a field on KnowledgeItem so it can be dropped
// cleanly once redirects are no longer needed, without touching the live
// model. `slug` is Post.slug as it existed at migration time.
model LegacyBlogSlug {
  slug            String        @id
  knowledgeItemId String
  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([knowledgeItemId])
  @@map("legacy_blog_slugs")
}

// ===== Peer Review & Feedback =====
// Replaces the former "Peer Review & Feedback" Forum category (deactivated,
// see seed.ts) with a dedicated invite-only review workflow: a member
// submits an item (same field shape as KnowledgeItem, reusing
// KnowledgeCategory/KnowledgeTag/KnowledgeContentType/KnowledgeLevel) and
// either hand-picks an audience (ReviewItemInvitee) or opens a community
// call for volunteers (seekingReviewers + ReviewVolunteerOffer). Comments
// (ReviewComment) are visible only to the submitter, invitees, and
// moderators/admins — never the general membership — so this is
// deliberately a separate model tree from KnowledgeItem, not a visibility
// flag on it; a ReviewItem never appears in Library queries.

enum ReviewItemStatus {
  open
  closed
}

enum ReviewVolunteerStatus {
  pending
  accepted
  declined
  withdrawn
}

model ReviewItem {
  id                        String               @id @default(cuid())
  title                     String
  description               String
  contentType               KnowledgeContentType
  level                     KnowledgeLevel
  submitterId               String
  submitter                 User                 @relation("ReviewItemSubmitter", fields: [submitterId], references: [id])
  youtubeUrl                String?
  externalUrl               String?
  heroImageUrl              String?
  deidentificationConfirmed Boolean              @default(false)
  status                    ReviewItemStatus     @default(open)
  // Independent of `status` — lets a submitter run an open call for
  // volunteers alongside (or instead of) a fixed invitee list, and stop
  // accepting new offers at any time without closing the whole review.
  seekingReviewers          Boolean              @default(false)
  // Submitter's note on what kind of feedback they're after (e.g. "just
  // sanity-check my sources," "looking for a harsh critique") — set at
  // creation time in "Request Volunteers" mode, shown to prospective
  // volunteers deciding whether to offer. Optional even then.
  volunteerNote             String?
  // Set once by publishReviewItemToLibrary (submitter-only, requires
  // status=closed) — the resulting KnowledgeItem always starts
  // pending_review, same Steward gate as any other Library submission.
  publishedKnowledgeItemId  String?              @unique
  publishedKnowledgeItem    KnowledgeItem?       @relation(fields: [publishedKnowledgeItemId], references: [id])
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  // Bumped to now() by toggleSeekingReviewers whenever the audience changes
  // (invite-only <-> open call) — drives the What's New feed's peer_review
  // sort so a re-opened/closed call resurfaces near the top instead of only
  // ever appearing once at its original createdAt, same convention as
  // ForumThread.lastActivityAt. Left at createdAt for an item whose audience
  // has never been toggled.
  lastActivityAt            DateTime             @default(now())

  categories      ReviewItemCategory[]
  tags            ReviewItemTag[]
  attachments     ReviewItemAttachment[]
  invitees        ReviewItemInvitee[]
  comments        ReviewComment[]
  volunteerOffers ReviewVolunteerOffer[]
  views           ReviewItemView[]

  @@index([submitterId])
  @@index([status])
  @@index([seekingReviewers])
  @@map("review_items")
}

// Who was invited to review a ReviewItem — mirrors KnowledgeItemInvitee/
// EventInvitee exactly. Added either directly by the submitter
// (updateReviewItemInvitees) or via an accepted ReviewVolunteerOffer.
model ReviewItemInvitee {
  id           String     @id @default(cuid())
  reviewItemId String
  reviewItem   ReviewItem @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("ReviewItemInvitee", fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([reviewItemId, userId])
  @@index([userId])
  @@map("review_item_invitees")
}

// Threaded feedback on a ReviewItem — same self-referential shape as
// ForumPost/PostComment (parentId/replies), visible only to the item's
// submitter, invitees, and moderators/admins (canViewReviewItem), never the
// general membership.
model ReviewComment {
  id           String     @id @default(cuid())
  reviewItemId String
  reviewItem   ReviewItem @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation("ReviewCommentAuthor", fields: [authorId], references: [id])
  body         String

  parentId String?
  parent   ReviewComment?  @relation("ReviewCommentThread", fields: [parentId], references: [id])
  replies  ReviewComment[] @relation("ReviewCommentThread")

  flagged    Boolean   @default(false)
  flagReason String?
  removed    Boolean   @default(false)
  editedAt   DateTime?
  createdAt  DateTime  @default(now())

  // The other direction of ContributionEvent.reviewCommentId — set only
  // when this was the author's *first* comment on the item (Knowledge
  // Hours accounting).
  contributionEvent ContributionEvent?

  @@index([reviewItemId])
  @@index([authorId])
  @@index([parentId])
  @@map("review_comments")
}

// One row per member who has visited a ReviewItem's detail page — unlike
// KnowledgeItemView/ThreadView (insert-once, raw visitor counters), this is
// an upsert-every-visit "last seen" timestamp, powering the dashboard's
// per-card "New" activity indicator (hasNewActivity: viewedAt is null or
// older than the item's latest comment/volunteer-offer).
model ReviewItemView {
  id           String     @id @default(cuid())
  reviewItemId String
  reviewItem   ReviewItem @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("ReviewItemViewer", fields: [userId], references: [id], onDelete: Cascade)
  viewedAt     DateTime   @default(now())

  @@unique([reviewItemId, userId])
  @@index([userId])
  @@map("review_item_views")
}

// Document/article/case-study binary only — never video (recorded lectures
// use ReviewItem.youtubeUrl instead), mirrors KnowledgeAttachment exactly.
model ReviewItemAttachment {
  id           String     @id @default(cuid())
  reviewItemId String
  reviewItem   ReviewItem @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)
  objectKey    String
  fileName     String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime   @default(now())

  @@index([reviewItemId])
  @@map("review_item_attachments")
}

// A ReviewItem can belong to more than one category — same many-to-many
// join shape as KnowledgeItemCategory, against the shared KnowledgeCategory
// taxonomy rather than a duplicated one.
model ReviewItemCategory {
  reviewItemId String
  reviewItem   ReviewItem        @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)
  categoryId   String
  category     KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([reviewItemId, categoryId])
  @@index([categoryId])
  @@map("review_item_categories")
}

model ReviewItemTag {
  reviewItemId String
  reviewItem   ReviewItem   @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)
  tagId        String
  tag          KnowledgeTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([reviewItemId, tagId])
  @@index([tagId])
  @@map("review_item_tags")
}

// A member's offer to review a `seekingReviewers` ReviewItem they weren't
// directly invited to (open-call mode). Unique per (item, user) so
// re-offering after a prior withdrawn/declined offer upserts the same row
// rather than creating a duplicate.
model ReviewVolunteerOffer {
  id           String                @id @default(cuid())
  reviewItemId String
  reviewItem   ReviewItem            @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)
  userId       String
  user         User                  @relation("ReviewVolunteer", fields: [userId], references: [id], onDelete: Cascade)
  note         String?
  status       ReviewVolunteerStatus @default(pending)
  createdAt    DateTime              @default(now())
  respondedAt  DateTime?

  @@unique([reviewItemId, userId])
  @@index([reviewItemId])
  @@index([userId])
  @@map("review_volunteer_offers")
}

// ===== Discussion Forums (§4.13) =====

// Admin-manageable forum category (§4.13) — seeded with six categories from
// Member_Communications.md; `active`/`displayOrder` follow the same
// retire-without-delete + explicit-ordering convention as TeamMember (§4.12),
// since the org is expected to add/retire categories over time.
model Forum {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  description  String?
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  threads ForumThread[]
  follows ForumFollow[]

  @@map("forums")
}

// Follow toggle for a Forum (§4.13) — following suppresses per-post
// forum_reply_mention notifications in favor of future digest batching
// (§4.10, Phase 6); digest delivery itself isn't built yet, this only
// persists the toggle so createForumPost can check it.
model ForumFollow {
  id        String   @id @default(cuid())
  forumId   String
  forum     Forum    @relation(fields: [forumId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([forumId, userId])
  @@index([userId])
  @@map("forum_follows")
}

// Member-Initiated Restricted Forum Threads (§4.13, §11.16). `community`
// (the only behavior that existed before this) is visible to the whole
// membership, unconditionally; `invited` is visible only to the thread's
// author and the members listed in ForumThreadInvitee — enforced in every
// member-facing query in lib/forums-server.ts/lib/feed-server.ts, never in
// the DB layer, same convention as EventVisibility. Only ever set on a
// standalone thread (eventId and knowledgeItemId both null) — a thread
// that inherits restriction from its linked Event/KnowledgeItem never sets
// this to `invited`; inherited and member-initiated restriction are
// mutually exclusive, enforced in createForumThread/
// updateForumThreadInvitees.
enum ForumThreadVisibility {
  community
  invited
}

model ForumThread {
  id             String                @id @default(cuid())
  forumId        String
  forum          Forum                 @relation(fields: [forumId], references: [id])
  authorId       String
  author         User                  @relation("ForumThreadAuthor", fields: [authorId], references: [id])
  title          String
  pinned         Boolean               @default(false)
  visibility     ForumThreadVisibility @default(community)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  // Bumped to the latest reply's createdAt (or left at createdAt if the
  // thread has no replies yet) by createForumPost — drives the What's New
  // feed's forum_thread sort so a thread with fresh activity resurfaces
  // instead of only ever appearing once at its original creation time.
  lastActivityAt DateTime              @default(now())

  posts    ForumPost[]
  views    ThreadView[]
  invitees ForumThreadInvitee[]

  // Set only for the auto-created thread behind an Event's optional
  // "create a discussion thread" checkbox (§4.6) — null for every
  // ordinary member-started thread.
  eventId String? @unique
  event   Event?  @relation(fields: [eventId], references: [id])

  // Set only for the on-demand discussion thread started from a Knowledge
  // Library item's "Start a Discussion" button (§4.9) — unlike eventId
  // above, created lazily (not at KnowledgeItem submission time) the first
  // time any member wants to discuss the resource. Lives in the seeded
  // "Library Discussions" forum, not Research & Resources.
  knowledgeItemId String?        @unique
  knowledgeItem   KnowledgeItem? @relation(fields: [knowledgeItemId], references: [id])

  @@index([forumId])
  @@index([authorId])
  @@map("forum_threads")
}

// Invite list for a member-initiated restricted ForumThread
// (visibility: invited) — mirrors EventInvitee/KnowledgeItemInvitee
// exactly, no RSVP analog (same rationale as KnowledgeItemInvitee's doc
// comment). One row per invited member; rows are added/removed
// independently after creation via updateForumThreadInvitees, which keeps
// this table non-empty for as long as the thread stays `invited` — no path
// to flip back to `community` in v1.
model ForumThreadInvitee {
  id        String      @id @default(cuid())
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("ForumThreadInvitee", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([threadId, userId])
  @@index([userId])
  @@map("forum_thread_invitees")
}

// One row per unique member visit to a ForumThread (§4.13), for the
// eye-icon view count on /forums/[category]/[threadId] — unlike Blog's
// PostView, forums require a session (both thread pages redirect signed-out
// visitors to /sign-in), so there's no anonymous-visitor case to key
// around; this dedupes by User.id directly rather than PostView's opaque
// viewerKey string.
model ThreadView {
  id        String      @id @default(cuid())
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([threadId, userId])
  @@map("thread_views")
}

// Top-level posts and replies are the same entity, threaded by
// `parentPostId` (§4.13) — same self-relation convention as PostComment/
// InboxMessage. `deidentificationConfirmed` mirrors KnowledgeItem/Event's
// app-enforced gate, only meaningful (and only enforced) for posts in the
// Clinical Discussions forum. `flagged` routes into the same shared
// moderation model as flagged Library content (§4.9/§4.13) — a boolean
// rather than a status enum since, unlike KnowledgeItem, a forum post has
// no publish workflow to also encode.
model ForumPost {
  id       String      @id @default(cuid())
  threadId String
  thread   ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId String
  author   User        @relation("ForumPostAuthor", fields: [authorId], references: [id])
  body     String

  parentPostId String?
  parentPost   ForumPost?  @relation("ForumPostThread", fields: [parentPostId], references: [id])
  replies      ForumPost[] @relation("ForumPostThread")

  deidentificationConfirmed Boolean @default(false)
  flagged                   Boolean @default(false)
  // Required reason the flagging member gave (§4.13) — same "flag is
  // one-way for the flagger, only a moderator resolving it clears this"
  // convention as Post.flagReason.
  flagReason                String?
  // Set by a moderator/admin resolving a flagged post from /admin/content
  // (§4.11/§4.13). The row itself is kept (never deleted) so parentPostId
  // threading on any replies stays intact — the UI swaps in a placeholder
  // for a removed post's body instead.
  removed                   Boolean @default(false)

  // Set when the author (or an admin/moderator) edits this post's body
  // after posting — distinct from `updatedAt` (also touched by
  // flagForumPost/resolveForumPostFlag) so the "(edited)" UI indicator
  // can't misfire off a moderation action. Null until the first edit.
  editedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Images pasted into this post's body — see PastedImage.
  pastedImages PastedImage[]

  @@index([threadId])
  @@index([authorId])
  @@index([parentPostId])
  @@map("forum_posts")
}

// Phase 6 data model — Trust & Safety, Notification digests & Admin (PRD
// §4.10/§4.11/§4.15). Data foundation only; /admin/conduct,
// /admin/privacy-requests UI, the digest-batching job, and announcement
// send flow are later 6.x objectives.

// ===== Trust & Safety / Compliance (§4.15) =====

enum ConductActionTaken {
  warning
  suspension
  removal
}

// Code of Conduct enforcement record (§4.15). `reporterId` is nullable for
// system-flagged violations (no named reporter). A row starts as an open
// report (`actionTaken`/`handledByUserId`/`actionTakenAt` all null) created
// by a member's report (6.3); an admin reviewing it in /admin/conduct sets
// those three fields together once they record a warning/suspension/removal.
// Never publicly visible — visible only to the affected member (once
// actioned) and to admins (app-enforced, same as other visibility rules in
// this schema). `suspension`/`removal` actions are expected to also set
// User.suspended/suspendedAt, but that's an app-code side effect, not a DB
// constraint.
model CodeOfConductViolation {
  id              String              @id @default(cuid())
  reportedUserId  String
  reportedUser    User                @relation("ConductViolationReported", fields: [reportedUserId], references: [id])
  reporterId      String?
  reporter        User?               @relation("ConductViolationReporter", fields: [reporterId], references: [id])
  description     String
  actionTaken     ConductActionTaken?
  handledByUserId String?
  handledByUser   User?               @relation("ConductViolationHandledBy", fields: [handledByUserId], references: [id])
  actionTakenAt   DateTime?
  // Set when the reported member dismisses the notice from Settings/Dashboard
  // (self-service, not admin-controlled) — null means it's still an
  // outstanding "needs attention" item on the Dashboard.
  acknowledgedAt  DateTime?
  occurredAt      DateTime            @default(now())
  createdAt       DateTime            @default(now())

  @@index([reportedUserId])
  @@map("code_of_conduct_violations")
}

enum PrivacyRequestType {
  export
  deletion
}

// Same pending/confirmed-style lifecycle convention as LedgerStatus, applied
// to §4.15's export/deletion fulfillment workflow.
enum PrivacyRequestStatus {
  pending
  fulfilled
  rejected
}

// GDPR-style data export/deletion request (§4.15), fulfilled from
// /admin/privacy-requests. `handledByUserId` is null until an admin picks
// it up; `fulfilledAt` is set once the export/deletion has actually been
// carried out, not merely acknowledged.
model PrivacyDataRequest {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation("PrivacyRequestUser", fields: [userId], references: [id])
  type            PrivacyRequestType
  status          PrivacyRequestStatus @default(pending)
  requestedAt     DateTime             @default(now())
  fulfilledAt     DateTime?
  handledByUserId String?
  handledByUser   User?                @relation("PrivacyRequestHandledBy", fields: [handledByUserId], references: [id])

  @@index([userId])
  @@map("privacy_data_requests")
}

// Generic cross-domain admin/moderator action audit trail — "who did what,
// when" for the several domains sharing one admin panel (applications,
// conduct, privacy requests, content moderation, contact messages). An
// admin resolving an alert-worthy item clears that alert for every admin,
// so this exists to make the resolution itself visible and attributable.
// Deliberately domain-agnostic (entityType/entityId discriminator + a
// free-form action string + optional metadata) rather than a
// TierHistory-style dedicated table per domain, since a fixed-subject
// relation table would need its own migration for every new domain covered.
model AdminActionLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AdminActionLogActor", fields: [actorId], references: [id])
  // Free-form, dotted, e.g. "conduct.warning", "content.removed",
  // "contact_message.read" — a plain String (not an enum) so a new action
  // verb never needs a migration; human-readable labels live in lib/audit.ts.
  action     String
  // Discriminator naming the Prisma model the action was taken on, e.g.
  // "MembershipApplication", "CodeOfConductViolation", "ContactMessage".
  entityType String
  // Nullable for forward-compatibility only — every call site today
  // populates this.
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("admin_action_log")
}

// ===== Notifications (§4.10) =====

// Per-type opt-out (§4.10) — one row per (user, type) the member has
// explicitly opted out of; absence of a row means the default (opted in).
// `board_announcement` is deliberately excluded from being creatable for
// that type in app code — the Board's broadcast channel cannot be muted.
model NotificationPreference {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  optedOut  Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, type])
  @@map("notification_preferences")
}

// Board-authored broadcast (§4.10) — fans out to every member's
// notification feed (+ email) as a `board_announcement` Notification once
// sent. `sentAt` null = draft, set = sent, same nullable-timestamp-as-status
// convention as Post.publishedAt. Member-facing surfaces (feed, detail page,
// email) deliberately mask `author` behind a fixed "NASIHA Board" identity —
// `authorId` is still the real sender, used only by the admin history list.
// `retractedAt` set = hidden from the feed/detail page and its Notification
// rows deleted (can't un-send the email already delivered) — the row itself
// is kept, retracted, so the admin history list retains an audit trail.
model Announcement {
  id            String    @id @default(cuid())
  title         String
  body          String
  authorId      String
  author        User      @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  // MinIO object key in the attachments/ bucket, same pattern as
  // Post.heroImageUrl — a single optional cover image, not a multi-file
  // attachment system.
  heroImageUrl  String?
  // Per-channel delivery toggles — which surfaces this send fanned out to.
  // Default true on all three preserves prior all-channels behavior for
  // existing rows and is the sensible default for new sends too.
  showInFeed    Boolean   @default(true)
  notifyInApp   Boolean   @default(true)
  sendEmail     Boolean   @default(true)
  // Set only on the auto-generated welcome-new-member Announcement
  // (lib/welcome-announcement.ts) so the feed/detail views can render a
  // tier badge after the member's name in the title — null for every other
  // Announcement.
  welcomeTier   Tier?
  sentAt        DateTime?
  retractedAt   DateTime?
  retractedById String?
  retractedBy   User?     @relation("AnnouncementRetractedBy", fields: [retractedById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("announcements")
}

// ===== Surveys =====

enum SurveyStatus {
  draft
  scheduled
  open
  closed
}

enum SurveyQuestionType {
  short_text
  long_text
  single_choice
  multi_choice
  rating
  yes_no
}

// Admin-authored survey (community polling). Unlike Announcement, sending is
// a multi-step lifecycle (draft -> scheduled -> open -> closed) rather than
// immediate-on-create, since a survey needs a question set built up first
// and can be scheduled/reopened/closed independently of when it was
// authored. `generation` is bumped on every open/reopen so a stale delayed
// auto-close job (queued before a reopen) can no-op instead of closing a
// survey the admin just reopened — see lib/queues/survey-queue.ts.
model Survey {
  id           String       @id @default(cuid())
  title        String
  description  String?
  authorId     String
  author       User         @relation("SurveyAuthor", fields: [authorId], references: [id])
  status       SurveyStatus @default(draft)
  // MinIO object key in the attachments/ bucket, same pattern as
  // Announcement.heroImageUrl/Post.heroImageUrl — a single optional cover
  // image, shown on the compose/edit form, the invite email, the public
  // respond page, and the What's New feed row.
  heroImageUrl String?

  // Audience checkboxes (default: members only) — resolved into
  // SurveyInvitation rows once, at send time, so the recipient list is a
  // snapshot rather than re-evaluated live as tiers/donations/registrations
  // change while the survey is open.
  audienceMembers          Boolean @default(true)
  audienceDonors           Boolean @default(false)
  audienceEventRegistrants Boolean @default(false)

  scheduledStartAt DateTime? // null + sent immediately => no scheduled-open job
  durationDays     Int? // null => no auto-close job
  openedAt         DateTime?
  closedAt         DateTime?
  closedById       String?
  closedBy         User?     @relation("SurveyClosedBy", fields: [closedById], references: [id])
  generation       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions   SurveyQuestion[]
  invitations SurveyInvitation[]
  responses   SurveyResponse[]

  @@map("surveys")
}

model SurveyQuestion {
  id       String             @id @default(cuid())
  surveyId String
  survey   Survey             @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  order    Int
  prompt   String
  type     SurveyQuestionType
  required Boolean            @default(true)
  options  String[] // single_choice / multi_choice only

  answers SurveyAnswer[]

  @@index([surveyId])
  @@map("survey_questions")
}

// One row per resolved recipient at send time — the audience snapshot, the
// magic-link token that authenticates their response (no login required,
// even for members: a single unified response path for every source), and
// the dedup key. `source` records which audience checkbox produced this
// row, for the recipients report.
model SurveyInvitation {
  id          String    @id @default(cuid())
  surveyId    String
  survey      Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  email       String
  name        String?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  source      String // "member" | "donor" | "event_registrant"
  token       String    @unique
  sentAt      DateTime?
  respondedAt DateTime?

  response SurveyResponse?

  @@unique([surveyId, email])
  @@index([token])
  @@map("survey_invitations")
}

model SurveyResponse {
  id           String           @id @default(cuid())
  surveyId     String
  survey       Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  invitationId String           @unique
  invitation   SurveyInvitation @relation(fields: [invitationId], references: [id])
  submittedAt  DateTime         @default(now())

  answers SurveyAnswer[]

  @@index([surveyId])
  @@map("survey_responses")
}

model SurveyAnswer {
  id         String         @id @default(cuid())
  responseId String
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  // Cascade (not the Restrict default) so deleting a Survey can cascade all
  // the way through Question -> Answer in one statement — Postgres
  // processes the Survey -> Question and Survey -> Response -> Answer
  // cascade paths in a single DELETE, and a Restrict here would race
  // against that (Question's delete blocked by an Answer that the other
  // path hasn't removed yet).
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String[] // 1 element except multi_choice, which can have several

  @@unique([responseId, questionId])
  @@map("survey_answers")
}

// Which content type a pasted image belongs to — dispatches
// canViewPastedImage (lib/pasted-images-server.ts) to the matching
// visibility check (forum thread visibility, Inbox sender/recipient,
// KnowledgeItem visibility) since a pasted image must be exactly as
// private as the content it's embedded in.
enum PastedImageOwnerType {
  forum_post
  inbox_message
  library_item
}

// Tracks every clipboard-pasted image uploaded into a Forum post, Inbox
// message, or Library blog_post body (lib/pasted-images-server.ts). A row
// starts unlinked (all owner FKs null, visible only to its uploader) right
// after upload, then gets linked to the saved post/message/item once its
// `![](url)`/`<img src>` reference is confirmed present in the saved body —
// letting an abandoned draft's upload stay orphaned rather than silently
// attached to unrelated content. onDelete: Cascade cleans up the DB row
// when the owning post/message/item is deleted, but the MinIO object still
// needs an explicit deletePastedImageObject call since cascade can't reach
// object storage.
model PastedImage {
  id         String               @id @default(cuid())
  key        String               @unique
  uploaderId String
  uploader   User                 @relation("PastedImageUploader", fields: [uploaderId], references: [id])
  ownerType  PastedImageOwnerType

  forumPostId String?
  forumPost   ForumPost? @relation(fields: [forumPostId], references: [id], onDelete: Cascade)

  inboxMessageId String?
  inboxMessage   InboxMessage? @relation(fields: [inboxMessageId], references: [id], onDelete: Cascade)

  knowledgeItemId String?
  knowledgeItem   KnowledgeItem? @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([forumPostId])
  @@index([inboxMessageId])
  @@index([knowledgeItemId])
  @@map("pasted_images")
}
